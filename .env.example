# Public canonical origin used for canonical URLs, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.yunhongtex.com

# Supabase — create a project at https://supabase.com and copy these from
# Project Settings → API. The anon key is safe to expose; the service role
# key must NEVER reach the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Seed admin credentials (used once by scripts/seed.mjs to create the login)
ADMIN_EMAIL=
ADMIN_PASSWORD=
