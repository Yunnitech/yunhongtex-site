# ---------------------------------------------------------------------------
# yunhongtex-site environment variables
# Copy to .env for local development and mirror on Vercel (Environment
# Variables) for production.
# ---------------------------------------------------------------------------

# Public canonical origin used for canonical URLs, sitemap, JSON-LD and
# absolute OG image URLs.
NEXT_PUBLIC_SITE_URL=https://www.yunhongtex.com

# --- Content store (REQUIRED in production) ---------------------------------
# The admin panel writes site content to Upstash Redis (Vercel's filesystem
# is read-only). On Vercel you can use the KV equivalents instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=      # Vercel KV equivalent of UPSTASH_REDIS_REST_URL
# KV_REST_API_TOKEN=    # Vercel KV equivalent of UPSTASH_REDIS_REST_TOKEN

# --- Admin auth (REQUIRED) --------------------------------------------------
# Single-password admin login. There is NO fallback: without this variable
# the /admin area stays locked.
ADMIN_PASSWORD=

# --- RFQ enquiries (optional but recommended) -------------------------------
# If set, RFQ form submissions are emailed via Resend. If unset, submissions
# are only logged to the server console.
RESEND_API_KEY=
RESEND_FROM="Yunhong Textiles <rfq@yunhongtex.com>"
RFQ_TO=sales@yunhongtex.com

# --- Google Analytics 4 -----------------------------------------------------
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Optional: GA4 Measurement Protocol API secret (GA4 → Admin → Data streams →
# Measurement Protocol API secrets). Enables server-side conversion tracking
# for RFQ submissions that works even when the visitor blocks gtag.
GA4_MP_API_SECRET=

# --- Supabase (OPTIONAL) ----------------------------------------------------
# Legacy optional read-only data source. The site works without it — content
# lives in the store (Redis/JSON) with static seeds as fallback.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # scripts/seed.ts only
DB_PASSWORD=                 # scripts/setup-db.ts only (direct Postgres)
